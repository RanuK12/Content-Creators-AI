{
  "_meta": {
    "title": "Workflow B - Outfit Variation",
    "description": "Inpainting-based outfit changes with ControlNet depth to maintain body proportions",
    "research_note": "Tests whether inpainting preserves identity while allowing clothing changes"
  },
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "flux1-dev-fp8.safetensors"
    }
  },
  "2": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": ["1", 0],
      "clip": ["1", 1],
      "lora_name": "character_identity.safetensors",
      "strength_model": 0.8,
      "strength_clip": 0.8
    }
  },
  "10": {
    "class_type": "LoadImage",
    "_comment": "Source image (character with original outfit)",
    "inputs": {
      "image": "source_outfit.png"
    }
  },
  "11": {
    "class_type": "LoadImage",
    "_comment": "Mask covering clothing area (white = inpaint zone)",
    "inputs": {
      "image": "outfit_mask.png"
    }
  },
  "15": {
    "class_type": "ControlNetLoader",
    "_comment": "Depth ControlNet to maintain body shape",
    "inputs": {
      "control_net_name": "control_v11f1p_sd15_depth.pth"
    }
  },
  "16": {
    "class_type": "DepthAnythingPreprocessor",
    "_comment": "Generate depth map from source",
    "inputs": {
      "image": ["10", 0]
    }
  },
  "20": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": ["10", 0],
      "vae": ["1", 2]
    }
  },
  "21": {
    "class_type": "SetLatentNoiseMask",
    "inputs": {
      "samples": ["20", 0],
      "mask": ["11", 0]
    }
  },
  "30": {
    "class_type": "CLIPTextEncode",
    "_comment": "Outfit description prompt",
    "inputs": {
      "clip": ["2", 1],
      "text": "ohwx wearing elegant red dress, professional fashion photography, high quality, detailed fabric texture"
    }
  },
  "31": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 1],
      "text": "blurry, low quality, distorted, mismatched lighting, visible seam"
    }
  },
  "32": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": ["30", 0],
      "negative": ["31", 0],
      "control_net": ["15", 0],
      "image": ["16", 0],
      "strength": 0.6,
      "start_percent": 0.0,
      "end_percent": 1.0
    }
  },
  "40": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["2", 0],
      "positive": ["32", 0],
      "negative": ["32", 1],
      "latent_image": ["21", 0],
      "seed": 42,
      "steps": 25,
      "cfg": 7.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 0.7
    }
  },
  "50": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["40", 0],
      "vae": ["1", 2]
    }
  },
  "60": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["50", 0],
      "filename_prefix": "outfit_variation"
    }
  }
}
