{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "flux1-dev-fp8.safetensors"
    },
    "_meta": {
      "title": "Load Flux.1 Dev Checkpoint"
    }
  },
  "2": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": ["1", 0],
      "clip": ["1", 1],
      "lora_name": "character_a_v2.safetensors",
      "strength_model": 0.85,
      "strength_clip": 0.85
    },
    "_meta": {
      "title": "LoRA Loader - Character A"
    }
  },
  "3": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": ["2", 0],
      "clip": ["2", 1],
      "lora_name": "character_b_v1.safetensors",
      "strength_model": 0.80,
      "strength_clip": 0.80
    },
    "_meta": {
      "title": "LoRA Loader - Character B"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["3", 1],
      "text": "two people in a modern art gallery, professional photography, natural lighting, sharp focus, 8k"
    },
    "_meta": {
      "title": "Global Positive Prompt"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["3", 1],
      "text": "blurry, deformed, ugly, bad anatomy, extra limbs, duplicate faces, merged faces, low quality"
    },
    "_meta": {
      "title": "Global Negative Prompt"
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["3", 1],
      "text": "character_a, woman with auburn hair, elegant dress, standing on left side, looking at artwork"
    },
    "_meta": {
      "title": "Regional Prompt - Character A (Left)"
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["3", 1],
      "text": "character_b, man with dark hair, tailored suit, standing on right side, holding wine glass"
    },
    "_meta": {
      "title": "Regional Prompt - Character B (Right)"
    }
  },
  "8": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1344,
      "height": 768,
      "batch_size": 1
    },
    "_meta": {
      "title": "Latent Image (16:9)"
    }
  },
  "9": {
    "class_type": "SolidMask",
    "inputs": {
      "value": 1.0,
      "width": 672,
      "height": 768
    },
    "_meta": {
      "title": "Region Mask - Left Half (Character A)"
    }
  },
  "10": {
    "class_type": "SolidMask",
    "inputs": {
      "value": 1.0,
      "width": 672,
      "height": 768
    },
    "_meta": {
      "title": "Region Mask - Right Half (Character B)"
    }
  },
  "11": {
    "class_type": "ConditioningSetMask",
    "inputs": {
      "conditioning": ["6", 0],
      "mask": ["9", 0],
      "strength": 0.90,
      "set_cond_area": "default"
    },
    "_meta": {
      "title": "Apply Region Mask to Character A Conditioning"
    }
  },
  "12": {
    "class_type": "ConditioningSetMask",
    "inputs": {
      "conditioning": ["7", 0],
      "mask": ["10", 0],
      "strength": 0.90,
      "set_cond_area": "default"
    },
    "_meta": {
      "title": "Apply Region Mask to Character B Conditioning"
    }
  },
  "13": {
    "class_type": "ConditioningCombine",
    "inputs": {
      "conditioning_1": ["11", 0],
      "conditioning_2": ["12", 0]
    },
    "_meta": {
      "title": "Combine Regional Conditioning"
    }
  },
  "14": {
    "class_type": "ConditioningCombine",
    "inputs": {
      "conditioning_1": ["4", 0],
      "conditioning_2": ["13", 0]
    },
    "_meta": {
      "title": "Combine Global + Regional Positive"
    }
  },
  "15": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["3", 0],
      "positive": ["14", 0],
      "negative": ["5", 0],
      "latent_image": ["8", 0],
      "seed": 42,
      "steps": 30,
      "cfg": 3.5,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0
    },
    "_meta": {
      "title": "KSampler - Multi-Character Generation"
    }
  },
  "16": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["15", 0],
      "vae": ["1", 2]
    },
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "17": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["16", 0],
      "filename_prefix": "multi_character"
    },
    "_meta": {
      "title": "Save Multi-Character Image"
    }
  },
  "_meta": {
    "title": "Workflow D - Multi-Character Scene Generation",
    "description": "Generates scenes with two distinct characters using regional prompting and dual LoRA loaders. Each character is constrained to a spatial region via conditioning masks, preventing identity blending.",
    "research_note": "Regional prompting with dual LoRAs requires careful weight balancing. Character A (first loaded) tends to dominate; compensate by slightly increasing Character B's strength. Flux architecture handles regional conditioning better than SDXL for this use case. CFG 3.5 is optimal for Flux multi-subject generation.",
    "version": "1.0",
    "author": "Content-Creators-AI",
    "compatible_models": ["flux1-dev-fp8.safetensors"],
    "vram_requirement_gb": 16
  }
}
